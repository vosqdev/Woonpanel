# ==============================================================================
# Netlify Environment Variables (Firebase Admin SDK koppeling)
# Configureer deze variabelen in Netlify via:
# Site configuration > Environment variables
# ==============================================================================

# 1. Firebase Project ID
FIREBASE_PROJECT_ID="woonpanel-productie"

# 2. Specifieke Firestore Database ID
FIRESTORE_DATABASE_ID="ai-studio-woonpanelwoondat-82310a5d-1984-446d-bdb2-bdda046470e5"

# 3. Firebase Service Account credentials (Kies Optie A of Optie B):
# Optie A: Losse variabelen
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@woonpanel-productie.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optie B: De volledige JSON inhoud van het Service Account bestand als één variabele
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"woonpanel-productie",...}'

# ==============================================================================
# AI Studio & Applicatie variabelen
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://woonpanel.com"
