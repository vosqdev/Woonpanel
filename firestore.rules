rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ingezonden onderzoeken & enquetes
    match /survey_submissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.surveyId is string
                    && request.resource.data.category is string
                    && request.resource.data.answers is map;
      allow update, delete: if false;
    }

    // Aangemelde panelleden van het Woonpanel
    match /panel_members/{memberId} {
      allow read: if true;
      allow create: if request.resource.data.email is string
                    && request.resource.data.firstName is string
                    && request.resource.data.lastName is string
                    && request.resource.data.privacyAgreed == true;
      allow update, delete: if false;
    }

    // Test connectiviteit
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
