rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bewuste blokkering van rechtstreekse browser-toegang (read/write).
    // Alle enquêtes en aanmeldingen verlopen uitsluitend server-side via Netlify Functions met Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
